FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY audit_app ./audit_app
ENV DATASET_ROOT=/server-dataset/container_images_verified PORT=8767
EXPOSE 8767
CMD ["sh", "-c", "uvicorn audit_app.main:app --host 0.0.0.0 --port ${PORT:-8767}"]
